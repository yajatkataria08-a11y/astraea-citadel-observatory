# ============================================================
# ASTRÆA Backend — Environment Variables (copy → .env)
# ============================================================

# HMAC signing secret for bearer tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here

# Token TTL in seconds (default: 7 days)
TOKEN_TTL_SECONDS=604800

# OAuth2 — Google (optional, leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 — Microsoft (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# OAuth2 — GitHub (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data paths (defaults work out-of-the-box; override only if moving data)
# DATA_DIR=./astro/data/raw
# DB_PATH=./backend/data/triage.sqlite3
